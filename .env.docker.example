# ─── Shared across all services ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CREDENTIALS_SECRET=your-64-char-hex-secret
INTERNAL_API_TOKEN=your-internal-api-token

# ─── mindspace-be ─────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=30d

PORT=4000
API_URL=http://be:4000
CORS_ORIGIN=https://mindspace.himanshuchahar.cloud

REDIS_URL=redis://redis:6379

AI_ENGINE_URL=http://ai-engine:5000
AI_ENGINE_TOKEN=your-ai-engine-token

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
CHAT_TOP_K=8

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=60

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://mindspace-api.himanshuchahar.cloud/api/auth/google/callback

SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://mindspace-api.himanshuchahar.cloud/api/integrations/slack/callback

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

CRONS_SERVICE_URL=http://ingest:4001

# ─── mindspace-ingest-service ─────────────────────────────────────────────────
BE_URL=http://be:4000

SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_ROLLUP_CRON=0 * * * *
SLACK_DAY_TIMEZONE=Asia/Kolkata
SLACK_NOISE_GATE_CHARS=40
SLACK_NOISE_GATE_HUMAN_COUNT=2

TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# ─── mindspace-ai-engine ──────────────────────────────────────────────────────
APP_ENV=production

EMBED_DIM=768
STAGE_TIMEOUT_SECONDS=90
STREAM_BLOCK_MS=5000
MAX_DELIVERIES=5

PEL_RECOVERY_INTERVAL_SECONDS=300
PEL_RECOVERY_MIN_IDLE_SECONDS=120
PEL_RECOVERY_BATCH_SIZE=50

# ─── mindspace-ui (build arg — also needed at runtime for SSR) ────────────────
NEXT_PUBLIC_API_URL=https://mindspace-api.himanshuchahar.cloud/api
